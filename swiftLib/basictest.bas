#RetroDevStudio.MetaData.BASIC:7169,BASIC V7.0,lowercase,10,10
10 IO=56832 : HACK=0 : BAUD=0+11 : PARITY=0 : REM ** $DE00,NOHACK,58600,8N1

20 IF EN=1 THEN 150
30 PRINT CHR$(14);"XTRA-UMB ERM 1.00":PRINT"BY RAIG RUCE, 14-PR-1998"
40 DV=PEEK(186)
50 CO=64:ML=49152:IF FRE(0)<>FRE(1) THEN CO=128:ML=4864
60 PRINT:PRINT"LOADING SWIFTLIB DRIVER..."
70 F$="SWIFTLIB"+MID$(STR$(CO),2) : EN=1
80 IF CO=128 THEN BLOAD (F$),U(DV) : GOTO 150
90 EN=1 : LOAD F$,DV,1 : GOTO 20

100 REM ** CALL ML ROUTINE: PC,A,X,Y IN AND A,X,Y,SR,CS OUT
110 IF CO=128 THEN SYS PC,A,X,Y,0 : RREG A,X,Y,SR : CS=SR AND 1 : RETURN
120 POKE 780,A : POKE 781,X : POKE 782,Y : POKE 783,0 : SYS PC
130 A=PEEK(780): X=PEEK(781) : Y=PEEK(782) : SR=PEEK(783) : CS=SR AND 1
140 RETURN

150 REM ** INITIALIZE
160 PRINT:PRINT "INITIALIZING ASCII TABLES..."
170 DIM TA%(255),TC%(255)
180 FOR I=0  TO 64 : TA%(I)=I    : TC%(I)=I    : NEXT
190 FOR I=65 TO 90 : TA%(I)=I+32 : TC%(I)=I+128: NEXT
200 FOR I=91 TO 95 : TA%(I)=I    : TC%(I)=I    : NEXT
210 FOR I=96 TO 122: TA%(I)=I-32 : TC%(I)=I-32 : NEXT
220 FOR I=123TO 127: TA%(I)=I    : TC%(I)=I+96 : NEXT
230 FOR I=128TO 191: TA%(I)=I    : TC%(I)=I    : NEXT
231 FOR I=192TO 218: TA%(I)=I-128: TC%(I)=I    : NEXT
232 FOR I=219TO 223: TA%(I)=I-96 : TC%(I)=I    : NEXT
233 FOR I=224TO 255: TA%(I)=I    : TC%(I)=I    : NEXT
234 TC%(10)=13 : TC%(13)=0 : TC%(96)=192 : TA%(192)=60 : TC%(8)=20 : TA%(8)=20
240 PRINT:PRINT "INITIALIZE SWIFTLINK..."
250 PC=ML+0 : Y=INT(IO/256) : A=IO-Y*256 : X=HACK : GOSUB 100

260 IF CS THEN PRINT "ERROR INITIALIZING SWIFTLINK!" : END

270 PC=ML+3 : A=BAUD : X=PARITY : GOSUB 100
280 IF CS=0 THEN 310
290 BAUD=(BAUD AND 15*16) + ((BAUD+1)AND 15)
300 PRINT "TRYING BAUD CODE";BAUD : GOTO 270
310 PRINT:PRINT "EDTERM READY":PRINT:PRINT CHR$(185);CHR$(157);
320 GET A$ : IF A$="" THEN 330
321 IF A$=CHR$(191) THEN 290
329 PC=ML+12 : A=TA%(ASC(A$)) : GOSUB 100
330 PC=ML+9 : GOSUB 100
331 IF X<>0 THEN PRINT " ";CHR$(157);CHR$(TC%(A));CHR$(185);CHR$(157);
340 GOTO 320
